FROM python:3.12-slim

WORKDIR /app

COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

COPY src/prototype/api ./src/prototype/api
COPY alembic.ini ./
COPY alembic ./alembic

EXPOSE 8000

CMD ["uvicorn", "src.prototype.api.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
